                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Manager\",\n  \"email\": \"manager@fleetflow.com\",\n  \"password\": \"SecurePass123\",\n  \"role\": \"fleet_manager\",\n  \"phone\": \"+1234567890\"\n}"
