# ==============================================
# FleetFlow Frontend Environment Configuration
# ==============================================

# API Configuration
# Backend API base URL
# Development: http://localhost:5000/api
# Production: https://api.your-domain.com/api
VITE_API_URL=http://localhost:5000/api

# Optional: Feature Flags
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_REALTIME_TRACKING=true

# Optional: Third-party Services
# VITE_GOOGLE_MAPS_API_KEY=your-api-key-here
# VITE_SENTRY_DSN=your-sentry-dsn-here

# ==============================================
# SECURITY NOTES:
# 1. Never commit the actual .env file to version control
# 2. All VITE_ prefixed variables are exposed to the client
# 3. Never put secrets or API keys in frontend .env
# 4. Use backend proxy for sensitive API calls
# ==============================================
