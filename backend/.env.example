# ==============================================
# FleetFlow Backend Environment Configuration
# ==============================================

# Database Configuration
# MongoDB connection string
# Local: mongodb://localhost:27017/fleetflow
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/fleetflow
MONGODB_URI=mongodb://localhost:27017/fleetflow

# JWT Configuration
# SECURITY: Use a strong, random secret (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-min-32-chars-CHANGE-THIS-IN-PRODUCTION
JWT_EXPIRATION=7d

# CORS Configuration
# Comma-separated list of allowed frontend origins
# Development: http://localhost:5173
# Production: https://your-domain.com,https://www.your-domain.com
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=5000
NODE_ENV=development

# Optional: Logging Configuration
# LOG_LEVEL=info
# LOG_FORMAT=json

# ==============================================
# SECURITY NOTES:
# 1. Never commit the actual .env file to version control
# 2. Use different JWT_SECRET for each environment
# 3. Restrict FRONTEND_URL to specific domains in production
# 4. Set NODE_ENV=production in production deployments
# 5. Use environment-specific MongoDB credentials
# ==============================================
